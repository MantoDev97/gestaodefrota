PORT=4173
HOST=127.0.0.1
ALERT_TIME=08:00
ALERT_TIMEZONE=America/Sao_Paulo
CRON_TOKEN=troque_este_token_para_chamadas_externas

# dry-run registra os alertas sem enviar; cloud envia pela WhatsApp Cloud API; webhook envia para uma API externa.
WHATSAPP_PROVIDER=dry-run

# WhatsApp Cloud API
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Webhook genérico para Evolution API, Z-API ou outro provedor
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=

# Destinatários operacionais
FLEET_MANAGER_WHATSAPP=5511999990001
OPERATION_SUPERVISOR_WHATSAPP=5511999990002
DEFAULT_RESPONSIBLE_WHATSAPP=5511888880000
