PORT=4173
HOST=127.0.0.1
ALERT_TIME=08:00
ALERT_TIMEZONE=America/Sao_Paulo
CRON_TOKEN=troque_este_token_para_chamadas_externas

# dry-run registra os alertas sem enviar; cloud envia pela WhatsApp Cloud API; webhook envia para uma API externa.
WHATSAPP_PROVIDER=dry-run

# WhatsApp Cloud API
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Webhook genérico para Evolution API, Z-API ou outro provedor.
# Para Z-API, use a URL /send-text em WHATSAPP_WEBHOOK_URL e o Client-Token em WHATSAPP_WEBHOOK_TOKEN.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=

# Evolution API para conexão por QR Code
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=gestao-frota

# Destinatários operacionais
FLEET_MANAGER_WHATSAPP=5594991712559
OPERATION_SUPERVISOR_WHATSAPP=5594991712559
DEFAULT_RESPONSIBLE_WHATSAPP=5594991712559

# Automação Gmail boletos
GMAIL_BOLETOS_DOWNLOAD_DIR=C:\Users\DevManto\Downloads\teste boleto
GMAIL_ARCHIVE_MAX_PER_RUN=50

# Para deploy online, cole o JSON inteiro como valor secreto no provedor.
GMAIL_OAUTH_CREDENTIALS_JSON=
GMAIL_OAUTH_TOKEN_JSON=
GMAIL_MODIFY_TOKEN_JSON=
